ConnectionStatus {
    dock: top;
    height: 1;
    background: $accent-darken-2;
    color: $text;
    padding: 0 1;
}

JobTable {
    height: 1fr;
}

JobTable > .datatable--cursor {
    background: $accent;
    color: $text;
}

JobTable > .datatable--header {
    background: $surface;
    color: $text-muted;
    text-style: bold;
}

JobDetail {
    dock: bottom;
    height: 3;
    background: $surface;
    color: $text;
    padding: 0 1;
    border-top: solid $primary-lighten-2;
}

StatusBar {
    dock: bottom;
    height: 1;
    background: $surface-darken-1;
    color: $text;
    padding: 0 1;
}

FilterBar {
    dock: bottom;
    height: 1;
    background: $surface;
    padding: 0 1;
}

FilterBar Input {
    height: 1;
    border: none;
    padding: 0;
}

TabbedContent {
    height: 1fr;
}
